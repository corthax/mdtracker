<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.1</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MD.Tracker Editor (1.05)</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>mdtracker_logo2.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>warnings</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="mdtracker_logo2.ico" />
    <Content Include="mdtracker_logo2.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
</Project>
