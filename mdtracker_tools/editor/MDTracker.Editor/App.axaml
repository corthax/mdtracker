<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MDTracker.Editor"
             xmlns:ctl="using:MDTracker.Editor.Controls"
             x:Class="MDTracker.Editor.App">
  <Application.Resources>
    <ctl:StringToIntConverter x:Key="StringToInt" />
  </Application.Resources>
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#0F0F15" />
      <Setter Property="Foreground" Value="PaleGoldenrod" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Background" Value="#151520" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#12121A" />
      <Setter Property="BorderBrush" Value="#333" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0A0A10" />
      <Setter Property="Foreground" Value="PaleGoldenrod" />
      <Setter Property="BorderBrush" Value="#444" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="#0A0A10" />
      <Setter Property="Foreground" Value="PaleGoldenrod" />
      <Setter Property="BorderBrush" Value="#444" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#0A0A10" />
      <Setter Property="Foreground" Value="PaleGoldenrod" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#2A2A40" />
      <Setter Property="Foreground" Value="PaleGoldenrod" />
      <Setter Property="BorderBrush" Value="#555" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#3A3A55" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="PaleGoldenrod" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Width" Value="16" />
      <Setter Property="Background" Value="#1A1A25" />
    </Style>
    <Style Selector="ScrollBar Thumb">
      <Setter Property="Background" Value="#3A3A55" />
      <Setter Property="MinWidth" Value="16" />
    </Style>
  </Application.Styles>
</Application>
