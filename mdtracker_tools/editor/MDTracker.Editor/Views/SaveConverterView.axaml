<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MDTracker.Editor.ViewModels"
             x:Class="MDTracker.Editor.Views.SaveConverterView"
             x:DataType="vm:SaveConverterViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="12" ColumnDefinitions="Auto,*">
    <TextBlock Text="v1.04 → v1.05 Save Converter" FontWeight="Bold" Grid.ColumnSpan="2" Margin="0,0,0,8" />

    <TextBlock Text="Source file:" Grid.Row="1" VerticalAlignment="Center" Margin="0,4" />
    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Spacing="4" Margin="8,4">
      <TextBlock Text="{Binding SourcePath}" VerticalAlignment="Center" Width="300" TextTrimming="CharacterEllipsis" />
      <Button Content="Browse" Command="{Binding OpenSourceCommand}" />
    </StackPanel>

    <TextBlock Text="Instruments used:" Grid.Row="2" VerticalAlignment="Center" Margin="0,4" />
    <TextBlock Text="{Binding UsedInstrumentCount}" Grid.Row="2" Grid.Column="1" Margin="8,4" />

    <TextBlock Text="Output size:" Grid.Row="3" VerticalAlignment="Center" Margin="0,4" />
    <ComboBox ItemsSource="{Binding OutputSizeLabels}"
              SelectedIndex="{Binding OutputSizeIndex}"
              Grid.Row="3" Grid.Column="1" Margin="8,4" Width="120" />

    <TextBlock Text="Output file:" Grid.Row="4" VerticalAlignment="Center" Margin="0,4" />
    <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" Spacing="4" Margin="8,4">
      <TextBlock Text="{Binding OutputPath}" VerticalAlignment="Center" Width="300" TextTrimming="CharacterEllipsis" />
      <Button Content="Save As..." Command="{Binding SaveOutputCommand}" />
    </StackPanel>

    <Button Content="Convert &amp; Save" Grid.Row="5" Grid.ColumnSpan="2" Command="{Binding SaveOutputCommand}"
            HorizontalAlignment="Left" Margin="0,8" />

    <TextBlock Text="{Binding Status}" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8" TextWrapping="Wrap" />
  </Grid>
</UserControl>
