<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MDTracker.Editor.ViewModels"
             xmlns:ctl="using:MDTracker.Editor.Controls"
             xmlns:m="using:MDTracker.Editor.Models"
             x:Class="MDTracker.Editor.Views.InstrumentEditorView"
             x:DataType="vm:InstrumentEditorViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="6">
      <Border BorderBrush="#444" BorderThickness="1" Padding="8" CornerRadius="4">
        <StackPanel Spacing="4">
          <TextBlock Text="FM Preset Header" FontWeight="Bold" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Algorithm:" VerticalAlignment="Center" Margin="0,2" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:InstrumentEditorViewModel.AlgorithmOptions}}" SelectedIndex="{Binding Algorithm}" Grid.Column="1" Width="70" Margin="4,2" FontSize="12">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:DropdownOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Feedback:" Grid.Row="1" VerticalAlignment="Center" Margin="0,2" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:InstrumentEditorViewModel.FeedbackOptions}}" SelectedIndex="{Binding Feedback}" Grid.Row="1" Grid.Column="1" Width="70" Margin="4,2" FontSize="12">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:DropdownOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Stereo:" Grid.Row="2" VerticalAlignment="Center" Margin="0,2" />
            <ComboBox ItemsSource="{Binding Source={x:Static vm:InstrumentEditorViewModel.StereoOptions}}" SelectedIndex="{Binding Stereo}" Grid.Row="2" Grid.Column="1" Width="70" Margin="4,2" FontSize="12">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:DropdownOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.ColumnSpan="2" Spacing="16" Margin="0,2">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="AMS:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Source={x:Static vm:InstrumentEditorViewModel.AmsOptions}}" SelectedIndex="{Binding Ams}" Width="70" FontSize="12">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:DropdownOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="FMS:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Source={x:Static vm:InstrumentEditorViewModel.FmsOptions}}" SelectedIndex="{Binding Fms}" Width="70" FontSize="12">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="m:DropdownOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Operators" FontWeight="Bold" />
      <ItemsControl ItemsSource="{Binding Operators}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OperatorEditorViewModel">
            <Border BorderBrush="#444" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,6,6" Width="200">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,100" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Text="MUL" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.MultipleOptions}}" SelectedIndex="{Binding Multiple}" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="DT" Grid.Row="1" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.DetuneOptions}}" SelectedIndex="{Binding Detune}" Grid.Row="1" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="TL" Grid.Row="2" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ctl:NumericTextBox Text="{Binding TotalLevel, Converter={StaticResource StringToInt}}" Grid.Row="2" Grid.Column="1" FontSize="10" Height="22" Margin="4,1" />
                  <TextBlock Text="RS" Grid.Row="3" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.RateScalingOptions}}" SelectedIndex="{Binding RateScaling}" Grid.Row="3" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="AR" Grid.Row="4" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.AttackRateOptions}}" SelectedIndex="{Binding AttackRate}" Grid.Row="4" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="D1R" Grid.Row="5" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.FirstDecayRateOptions}}" SelectedIndex="{Binding FirstDecayRate}" Grid.Row="5" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="D2R" Grid.Row="6" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.SecondaryDecayRateOptions}}" SelectedIndex="{Binding SecondaryDecayRate}" Grid.Row="6" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="RR" Grid.Row="7" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.ReleaseRateOptions}}" SelectedIndex="{Binding ReleaseRate}" Grid.Row="7" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="D1L" Grid.Row="8" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.SecondaryAmplitudeOptions}}" SelectedIndex="{Binding SecondaryAmplitude}" Grid.Row="8" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="AM" Grid.Row="9" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <CheckBox IsChecked="{Binding AmEnabled}" Grid.Row="9" Grid.Column="1" Margin="4,1" VerticalAlignment="Center" />
                  <TextBlock Text="SSG" Grid.Row="10" FontSize="10" Margin="0,1" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding Source={x:Static vm:OperatorEditorViewModel.SsgEgOptions}}" SelectedIndex="{Binding SsgEg}" Grid.Row="10" Grid.Column="1" Margin="4,1" FontSize="10" Height="22">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:DropdownOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
