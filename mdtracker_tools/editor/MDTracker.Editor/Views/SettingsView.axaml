<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MDTracker.Editor.ViewModels"
             x:Class="MDTracker.Editor.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Margin="16" Spacing="12" MaxWidth="500">
    <TextBlock Text="ROM Addresses" FontSize="20" FontWeight="Bold" Foreground="PaleGoldenrod" />
    <TextBlock Text="These addresses vary between ROM builds. Update them if the ROM is rebuilt with different sample data positions." TextWrapping="Wrap" Foreground="#aaa" />

    <Separator />

    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
      <TextBlock Text="Sample settings address:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
      <TextBox x:Name="SampleSettingsTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding SampleSettingsAddrHex}" FontSize="15" FontFamily="Consolas" />

      <TextBlock Text="Sample bank address:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" />
      <TextBox x:Name="SampleBankTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding SampleBankAddrHex}" FontSize="15" FontFamily="Consolas" Margin="0,8,0,0" />

      <Button Grid.Row="2" Grid.Column="1" Content="Save Settings" Click="OnSaveSettingsClick" Margin="0,8,0,0" HorizontalAlignment="Left" />
    </Grid>
  </StackPanel>
</UserControl>
