<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MDTracker.Editor.ViewModels"
             xmlns:conv="using:MDTracker.Editor.Converters"
             x:Class="MDTracker.Editor.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Resources>
    <conv:HexStringConverter x:Key="HexStringConverter" />
  </UserControl.Resources>
  <StackPanel Margin="16" Spacing="12" MaxWidth="500">
    <TextBlock Text="ROM Addresses" FontSize="20" FontWeight="Bold" Foreground="PaleGoldenrod" />
    <TextBlock Text="These addresses vary between ROM builds. Update them if the ROM is rebuilt with different sample data positions." TextWrapping="Wrap" Foreground="#aaa" />

    <Separator />

    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto">
      <TextBlock Text="Sample settings address:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SampleSettingsAddr, Converter={StaticResource HexStringConverter}}" FontSize="15" FontFamily="Consolas" />

      <TextBlock Text="Sample bank address:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SampleBankAddr, Converter={StaticResource HexStringConverter}}" FontSize="15" FontFamily="Consolas" Margin="0,8,0,0" />
    </Grid>
  </StackPanel>
</UserControl>
