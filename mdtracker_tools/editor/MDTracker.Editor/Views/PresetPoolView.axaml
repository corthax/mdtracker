<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MDTracker.Editor.ViewModels"
             xmlns:m="using:MDTracker.Editor.Models"
             x:Class="MDTracker.Editor.Views.PresetPoolView"
             x:DataType="vm:PresetPoolViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="4">
    <TextBlock Text="Loaded Presets" FontWeight="Bold" Margin="0,0,0,4" />

    <ListBox Grid.Row="1"
             ItemsSource="{Binding Presets}"
             SelectedItem="{Binding SelectedPreset}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="m:InstrumentPreset">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBlock Text="{Binding Id}" Width="24" FontSize="11" />
            <TextBlock Text="{Binding Algorithm, StringFormat='ALG:{0}'}" Width="48" FontSize="11" />
            <TextBlock Text="{Binding Name}" Grid.Column="2" FontSize="11" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="2" Content="Remove" Command="{Binding RemovePresetCommand}" Margin="0,4,0,0" />
  </Grid>
</UserControl>
